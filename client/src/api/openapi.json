  "paths": {
    "/events": {
      "get": {
        "tags": [
          "events"
        ],
        "summary": "Upcoming events, a page at a time",
        "description": "Events that have not started yet, by start time (then id). Follow `next_cursor` until it is\nnull: new events stored while paging never make one repeat or go missing. Send the same filters\nwith every page. Days are Buenos Aires days: a show on Saturday at 22:00 there is a Saturday\nshow, although it is stored as Sunday 01:00 UTC.",
        "operationId": "list_events_events_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Events per page",
              "default": 20,
              "title": "Limit"
            },
            "description": "Events per page"
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "next_cursor of the previous page; leave out for the first",
              "title": "Cursor"
            },
            "description": "next_cursor of the previous page; leave out for the first"
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 100
                },
                {
                  "type": "null"
                }
              ],
              "description": "Search the title, artist and venue: every word must appear, ignoring case and accents",
              "title": "Q"
            },
            "description": "Search the title, artist and venue: every word must appear, ignoring case and accents"
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "description": "First day, YYYY-MM-DD, in Buenos Aires time (included)",
              "title": "From"
            },
            "description": "First day, YYYY-MM-DD, in Buenos Aires time (included)"
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Last day, YYYY-MM-DD, in Buenos Aires time (included)",
              "title": "To"
            },
            "description": "Last day, YYYY-MM-DD, in Buenos Aires time (included)"
          },
          {
            "name": "venue",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 100
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only this venue: a `name` from GET /venues, exactly",
              "title": "Venue"
            },
            "description": "Only this venue: a `name` from GET /venues, exactly"
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "concert",
                    "theatre",
                    "party",
                    "other"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only this kind of event",
              "title": "Category"
            },
            "description": "Only this kind of event"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventPage"
                }
              }
            }
          },
          "400": {
            "description": "The cursor was not issued by this API",
            "content": {
              "application/problem+json": {
                "schema": {
                  "properties": {
                    "type": {
                      "default": "about:blank",
                      "title": "Type",
                      "type": "string"
                    },
                    "title": {
                      "title": "Title",
                      "type": "string"
                    },
                    "status": {
                      "title": "Status",
                      "type": "integer"
                    },
                    "detail": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "title": "Detail"
                    },
                    "errors": {
                      "anyOf": [
                        {
                          "items": {
                            "additionalProperties": true,
                            "type": "object"
                          },
                          "type": "array"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "title": "Errors"
                    }
                  },
                  "required": [
                    "title",
                    "status"
                  ],
                  "title": "Problem",
                  "type": "object"
                }
              }
            }
          },
          "422": {
            "description": "limit, q, from, to, venue or category is not valid",
            "content": {
              "application/problem+json": {
                "schema": {
                  "properties": {
                    "type": {
                      "default": "about:blank",
                      "title": "Type",
                      "type": "string"
                    },
                    "title": {
                      "title": "Title",
                      "type": "string"
                    },
                    "status": {
                      "title": "Status",
                      "type": "integer"
                    },
                    "detail": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "title": "Detail"
                    },
                    "errors": {
                      "anyOf": [
                        {
                          "items": {
                            "additionalProperties": true,
                            "type": "object"
                          },
                          "type": "array"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "title": "Errors"
                    }
                  },
                  "required": [
                    "title",
                    "status"
                  ],
                  "title": "Problem",
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/events/{event_id}": {
      "get": {
        "tags": [
          "events"
        ],
        "summary": "One event, with the other upcoming dates of the same show",
        "description": "Every field of the event, including a past one, plus `other_dates`: the upcoming dates of the\nsame show, so the client can offer them without searching.",
        "operationId": "get_event_detail_events__event_id__get",
        "parameters": [
          {
            "name": "event_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Event Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventDetail"
                }
              }
            }
          },
          "404": {
            "description": "There is no event with this id",
            "content": {
              "application/problem+json": {
                "schema": {
                  "properties": {
                    "type": {
                      "default": "about:blank",
                      "title": "Type",
                      "type": "string"
                    },
                    "title": {
                      "title": "Title",
                      "type": "string"
                    },
                    "status": {
                      "title": "Status",
                      "type": "integer"
                    },
                    "detail": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "title": "Detail"
                    },
                    "errors": {
                      "anyOf": [
                        {
                          "items": {
                            "additionalProperties": true,
                            "type": "object"
                          },
                          "type": "array"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "title": "Errors"
                    }
                  },
                  "required": [
                    "title",
                    "status"
                  ],
                  "title": "Problem",
                  "type": "object"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/venues": {
      "get": {
        "tags": [
          "venues"
        ],
        "summary": "Venues with upcoming events",
        "description": "Every venue with at least one upcoming event, by name, with how many it has. Send a `name`\nas `venue` to GET /events to see that venue's events.",
        "operationId": "list_venues_venues_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VenueList"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    }
